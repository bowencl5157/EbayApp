# eBay API Configuration
EBAY_APP_TOKEN=your_app_token_here
EBAY_ACCESS_TOKEN=your_oauth_access_token_here
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here

# User Token for Trading API (seller operations)
EBAY_USER_TOKEN=your_user_oauth_token_here

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ebayuser
DB_PASSWORD=ebaypass
DB_NAME=ebayapp

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
