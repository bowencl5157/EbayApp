# eBay API Credentials
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_REDIRECT_URI=http://localhost:8000/oauth/callback
EBAY_MARKETPLACE_ID=EBAY_US

# Walmart API Credentials
WALMART_CLIENT_ID=your_walmart_client_id_here
WALMART_CLIENT_SECRET=your_walmart_client_secret_here

# PostgreSQL Database
DB_USER=ebayuser
DB_PASSWORD=ebaypass
DB_NAME=ebayapp
DATABASE_URL=postgresql://ebayuser:ebaypass@postgres:5432/ebayapp

# Redis Cache
REDIS_URL=redis://redis:6379/0
